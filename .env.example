# Copia este archivo como .env y ajusta los valores
PORT=3000
NODE_ENV=production
TZ=America/Bogota
# Genera uno largo y aleatorio: openssl rand -hex 32
SESSION_SECRET=cambia-este-secreto-por-uno-largo
# Código que la familia usa para registrarse (se puede cambiar luego en Admin > Ajustes)
FAMILY_CODE=ZABALA2026
# Admin inicial (se crea solo la primera vez que arranca)
ADMIN_NAME=Mario
ADMIN_EMAIL=proyectos@gapps.com.co
ADMIN_PASSWORD=cambia-esta-clave
# Datos de Nequi (también editables en Admin > Ajustes)
NEQUI_NUMBER=
NEQUI_HOLDER=
