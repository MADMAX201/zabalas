<%- include('partials/head') %>
<% const past = h.isPast(ev.ends_at || ev.starts_at); %>
<p><a href="/">← Todos los eventos</a></p>
<% if (ev.image) { %><img class="hero-img" src="/uploads/<%= ev.image %>" alt=""><% } %>
<div class="row between">
  <div>
    <h1><%= ev.title %><% if (ev.access_code) { %> <span class="badge muted">🔒 Privado</span><% } %></h1>
    <% if (dates.length > 1) { %>
    <p>📅 <b><%= dates.length %> fechas</b> · del <%= h.fmtShort(dates[0].starts_at) %> al <%= h.fmtShort(dates[dates.length-1].starts_at) %></p>
    <% } else { %>
    <p>📅 <b><%= h.fmtDateTime(ev.starts_at) %></b><% if (ev.ends_at) { %> — <%= h.fmtTime(ev.ends_at) %><% } %></p>
    <% } %>
    <% if (ev.location) { %><p>📍 <%= ev.location %><% if (ev.address) { %> · <a href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(ev.address) %>" target="_blank" rel="noopener"><%= ev.address %></a><% } %></p><% } %>
    <% if (!ev.published) { %><span class="badge warn">Borrador (solo lo ven administradores)</span><% } %>
    <% if (ev.status === 'pending') { %><span class="badge warn">Pendiente de aprobación (solo lo ves tú y los administradores)</span><% } else if (ev.status === 'rejected') { %><span class="badge bad">Rechazado</span><% } %>
  </div>
  <div class="row">
    <a class="btn ghost sm" href="/galeria?evento=<%= ev.id %>">📷 Galería</a>
    <a class="btn ghost sm" href="/galeria/subir?evento=<%= ev.id %>">＋ Subir fotos</a>
    <% if (canManage) { %><a class="btn sec sm" href="/admin/eventos/<%= ev.id %>">Administrar</a><% } %>
  </div>
</div>
<% if (ev.description) { %><div class="card mt" style="white-space:pre-line"><%= ev.description %></div><% } %>

<div class="grid two mt">
  <!-- ASISTENCIA -->
  <div class="card" id="asistencia">
    <h2>¿Vas a asistir?</h2>
    <p class="muted small">👥 <%= stats.going %> confirmados<% if (stats.guests) { %> + <%= stats.guests %> acompañantes<% } %><% if (stats.maybe) { %> · <%= stats.maybe %> tal vez<% } %></p>
    <% if (rsvpClosed) { %>
      <div class="flash muted">El plazo para confirmar cerró<% if (ev.rsvp_deadline) { %> el <%= h.fmtDateTime(ev.rsvp_deadline) %><% } %>.</div>
      <% if (myRsvp) { %><p>Tu respuesta: <span class="badge <%= h.RSVP[myRsvp.status].cls %>"><%= h.RSVP[myRsvp.status].label %></span></p><% } %>
    <% } else { %>
    <form method="post" action="/eventos/<%= ev.id %>/asistencia" id="rsvpForm">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <div class="seg">
        <% for (const s of ['yes','maybe','no']) { %>
        <label><input type="radio" name="status" value="<%= s %>" <%= myRsvp && myRsvp.status === s ? 'checked' : '' %> required><span><%= s==='yes'?'✅ Sí, voy':s==='maybe'?'🤔 Tal vez':'❌ No puedo' %></span></label>
        <% } %>
      </div>
      <% if (dates.length > 1) { %>
      <div id="datesBox" class="dates-box" <%= myRsvp && myRsvp.status !== 'yes' ? 'hidden' : '' %>>
        <div class="row between"><b>¿A cuáles fechas vas?</b>
          <span class="small"><a href="#" id="datesAll">Todas</a> · <a href="#" id="datesNone">Ninguna</a></span></div>
        <% dates.forEach(d => { const past = h.isPast(d.ends_at || d.starts_at); %>
        <label class="date-opt <%= past ? 'past' : '' %>">
          <input type="checkbox" name="date_ids" value="<%= d.id %>" <%= myDates.has(d.id) || (!myRsvp && !past) ? 'checked' : '' %>>
          <span class="date-chip sm"><b><%= h.parseLocal(d.starts_at).getDate() %></b><span><%= h.fmtShort(d.starts_at).split(' ')[1] %></span></span>
          <span class="date-txt">
            <b><%= d.label ? d.label + ' · ' : '' %><%= h.fmtDayShort(d.starts_at) %>, <%= h.fmtTime(d.starts_at) %><% if (d.ends_at) { %> – <%= h.fmtTime(d.ends_at) %><% } %></b>
            <span class="small muted"><% if (d.location || ev.location) { %>📍 <%= d.location || ev.location %> · <% } %>👥 <%= d.going %><%= past ? ' · ya pasó' : '' %></span>
          </span>
        </label>
        <% }) %>
      </div>
      <% } %>
      <div id="guestsBox" <%= myRsvp && myRsvp.status === 'yes' ? '' : 'hidden' %>>
        <div class="dates-box" id="companionsBox">
          <b>¿Quién va contigo?</b>
          <% if (!members.length) { %><div class="help">Agrega a las personas de tu núcleo familiar; quedan guardadas para los próximos eventos.</div><% } %>
          <% members.forEach(mm => { %>
          <label class="date-opt"><input type="checkbox" name="member_ids" value="<%= mm.id %>" <%= myCompanions.has(mm.id) ? 'checked' : '' %>>
            <span class="date-txt"><b><%= mm.name %></b><% if (mm.note) { %><span class="small muted"><%= mm.note %></span><% } %></span></label>
          <% }) %>
          <div id="newPeople"></div>
          <button type="button" class="btn ghost sm mt" id="addPerson">＋ Agregar persona</button>
          <div class="help"><a href="/perfil#familia">Administrar mi núcleo familiar</a></div>
        </div>
        <label for="guests">Otros acompañantes sin nombre (opcional)</label>
        <input id="guests" type="number" name="guests" min="0" max="20" value="<%= myRsvp ? Math.max(0, (myRsvp.guests || 0) - myCompanions.size) : 0 %>">
      </div>
      <label for="note">Nota (opcional)</label>
      <input id="note" type="text" name="note" maxlength="300" value="<%= myRsvp && myRsvp.note ? myRsvp.note : '' %>" placeholder="Llego tarde, llevo postre...">
      <% if (ev.rsvp_deadline) { %><div class="help">Puedes cambiar tu respuesta hasta el <%= h.fmtDateTime(ev.rsvp_deadline) %>.</div><% } %>
      <button class="btn mt" type="submit" id="rsvpSubmit"><%= myRsvp ? "Actualizar respuesta" : "Confirmar" %></button>
    </form>
    <% } %>

    <% if (!past) { %>
    <h3 class="mt2">Agendar</h3>
    <% if (dates.length > 1) { %>
    <div class="row">
      <% if (myDates.size) { %><a class="btn sec sm" href="/eventos/<%= ev.id %>/calendario.ics?mias=1">📥 Mis fechas (<%= myDates.size %>) al calendario</a><% } %>
      <a class="btn ghost sm" href="/eventos/<%= ev.id %>/calendario.ics">📥 Todas las fechas</a>
    </div>
    <details class="mt"><summary class="small muted" style="cursor:pointer">Agendar una por una / Google Calendar</summary>
      <table class="tbl small mt">
        <% dates.forEach(d => { %><tr><td><%= d.label ? d.label + ' · ' : '' %><%= h.fmtDayShort(d.starts_at) %>, <%= h.fmtTime(d.starts_at) %></td>
          <td class="right"><a href="/eventos/<%= ev.id %>/calendario.ics?fecha=<%= d.id %>">📥 .ics</a> · <a href="<%= d.gcal %>" target="_blank" rel="noopener">📆 Google</a></td></tr><% }) %>
      </table>
    </details>
    <% } else { %>
    <div class="row">
      <a class="btn sec sm" href="/eventos/<%= ev.id %>/calendario.ics">📥 Calendario (iPhone / Outlook)</a>
      <a class="btn sec sm" href="<%= gcal %>" target="_blank" rel="noopener">📆 Google Calendar</a>
    </div>
    <% } %>
    <% } %>

    <% if (dates.length > 1 && dates.some(d => d.going)) { %>
    <h3 class="mt2">Quiénes van por fecha</h3>
    <% dates.forEach(d => { if (!d.going) return; %>
      <p class="small" style="margin:4px 0"><b><%= d.label ? d.label + ' · ' : '' %><%= h.fmtDayShort(d.starts_at) %></b> (<%= d.going %>): <%= d.names.join(', ') %></p>
    <% }) %>
    <% } else if (attendees.length) { %>
    <h3 class="mt2">Quiénes van</h3>
    <div class="avatar-list">
      <% attendees.filter(a => a.status === 'yes').forEach(a => { %><span title="<%= a.companions.join(', ') %>"><%= a.name %><% if (a.companions.length) { %> + <%= a.companions.join(', ') %><% } %><% if (a.guests - a.companions.length > 0) { %> +<%= a.guests - a.companions.length %><% } %></span><% }) %>
    </div>
    <% const maybe = attendees.filter(a => a.status === 'maybe'); if (maybe.length) { %>
      <p class="small muted mt">Tal vez: <%= maybe.map(a => a.name).join(', ') %></p>
    <% } %>
    <% } %>
  </div>

  <!-- TIENDA -->
  <div class="card" id="tienda">
    <h2>Tienda del evento</h2>
    <% if (!products.length) { %>
      <p class="muted">Este evento no tiene productos para comprar.</p>
    <% } else { %>
    <% const pendingOrder = myOrders.find(o => o.status === 'pending'); %>
    <% if (pendingOrder) { %>
    <div class="flash warn">
      Tienes el <b>pedido #<%= pendingOrder.id %></b> sin pagar (<%= h.fmtCOP(pendingOrder.total) %>).
      <div class="row mt" style="gap:8px">
        <a class="btn sm" href="/pedidos/<%= pendingOrder.id %>">💸 Pagar ahora</a>
        <a class="btn sm sec" href="/pedidos/<%= pendingOrder.id %>/editar">✏️ Cambiar tallas o cantidades</a>
      </div>
    </div>
    <details><summary class="muted small" style="cursor:pointer">¿Necesitas hacer otro pedido aparte?</summary>
    <% } %>
    <p class="muted small mt">Elige talla y cantidad. Después pagas por Nequi y subes el comprobante.</p>
    <%- include('partials/store_form', { products, action: '/eventos/' + ev.id + '/pedido', prefill: [], submitLabel: 'Hacer pedido y ver datos de pago' }) %>
    <% if (pendingOrder) { %></details><% } %>
    <% } %>

    <% if (myOrders.length) { %>
    <h3 class="mt2">Mis pedidos en este evento</h3>
    <table class="tbl">
      <% myOrders.forEach(o => { %>
      <tr>
        <td><a href="/pedidos/<%= o.id %>">#<%= o.id %></a><br><span class="small muted"><%= o.items.map(i => `${i.qty}× ${i.name}${i.size ? ' ('+i.size+')' : ''}`).join(', ') %></span></td>
        <td class="right"><b><%= h.fmtCOP(o.total) %></b><br><span class="badge <%= h.ORDER_STATUS[o.status].cls %>"><%= h.ORDER_STATUS[o.status].label %></span></td>
      </tr>
      <% if (o.status === 'pending') { %>
      <tr><td colspan="2" style="padding-top:0;border-bottom:1px solid var(--line)">
        <div class="row" style="gap:8px">
          <a class="btn sm" href="/pedidos/<%= o.id %>">💸 Retomar pago</a>
          <a class="btn sm sec" href="/pedidos/<%= o.id %>/editar">✏️ Editar pedido</a>
        </div>
      </td></tr>
      <% } else if (o.status === 'rejected') { %>
      <tr><td colspan="2" style="padding-top:0"><a class="btn sm warn" href="/pedidos/<%= o.id %>">Subir otro comprobante</a></td></tr>
      <% } %>
      <% }) %>
    </table>
    <% } %>
  </div>
</div>

<template id="personTpl">
  <div class="new-person">
    <div class="row" style="gap:6px;align-items:flex-end">
      <div style="flex:2;min-width:140px"><label>Nombre y apellido</label><input type="text" name="new_name" maxlength="80" placeholder="Nombre y apellido" autocomplete="off"></div>
      <div style="flex:1;min-width:100px"><label>Parentesco</label><input type="text" name="new_note" maxlength="60" placeholder="hija, esposo…"></div>
      <button type="button" class="btn ghost sm rm" title="Quitar">✕</button>
    </div>
    <input type="hidden" name="new_alias" value="">
    <div class="dup-warn" hidden></div>
  </div>
</template>
<%- include('partials/foot') %>
