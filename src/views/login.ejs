<%- include('partials/head') %>
<div class="auth">
  <div class="card">
    <img class="auth-logo" src="/img/logo.jpeg" alt="<%= site.site_name %>">
    <h1>Ingresar</h1>
    <p class="muted center small">Sitio privado de la familia</p>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <form method="post" action="/login">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="email">Correo</label>
      <input id="email" type="email" name="email" value="<%= email %>" required autocomplete="email" autofocus>
      <label for="password">Contraseña</label>
      <input id="password" type="password" name="password" required autocomplete="current-password">
      <button class="btn block mt">Entrar</button>
    </form>
    <p class="center mt">¿Aún no tienes cuenta? <a href="/registro">Regístrate con el código familiar</a></p>
  </div>
</div>
<%- include('partials/foot') %>
