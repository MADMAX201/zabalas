<%- include('partials/head') %>
<p><a href="/eventos/<%= o.event_id %>">← <%= o.event_title %></a></p>
<div class="row between">
  <h1>Pedido #<%= o.id %></h1>
  <span class="badge <%= h.ORDER_STATUS[o.status].cls %>" style="font-size:.95rem"><%= h.ORDER_STATUS[o.status].label %></span>
</div>
<div class="grid two mt">
  <div class="card">
    <h2>Detalle</h2>
    <table class="tbl">
      <% o.items.forEach(i => { %>
      <tr><td><%= i.qty %>× <%= i.name %><% if (i.size) { %> · talla <b><%= i.size %></b><% } %><% if (i.for_name) { %><br><span class="small muted">Para: <%= i.for_name %></span><% } %></td><td class="right"><%= h.fmtCOP(i.qty * i.unit_price) %></td></tr>
      <% }) %>
      <tr><td><b>Total a pagar</b></td><td class="right"><b style="font-size:1.2rem"><%= h.fmtCOP(o.total) %></b></td></tr>
    </table>
    <p class="small muted">Creado el <%= h.fmtDateTime(o.created_at.replace(' ', 'T').slice(0,16)) %></p>
    <% if (o.admin_note) { %><div class="flash <%= o.status === 'rejected' ? 'bad' : 'info' %>">Mensaje del administrador: <%= o.admin_note %></div><% } %>
    <% if (o.status === 'pending') { %>
    <div class="row" style="gap:8px">
      <a class="btn sec sm" href="/pedidos/<%= o.id %>/editar">✏️ Editar pedido</a>
      <form method="post" action="/pedidos/<%= o.id %>/cancelar" data-confirm="¿Cancelar este pedido?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">Cancelar pedido</button></form>
    </div>
    <% } %>
  </div>

  <div class="card">
    <% if (o.status === 'paid') { %>
      <h2>✅ Pago confirmado</h2>
      <p>¡Gracias! Tu pago fue verificado<% if (o.paid_at) { %> el <%= h.fmtDateTime(o.paid_at.replace(' ', 'T').slice(0,16)) %><% } %>.</p>
      <% if (o.receipt) { %><p><a href="/uploads/<%= o.receipt %>" target="_blank">Ver comprobante</a></p><% } %>
    <% } else if (o.status === 'review') { %>
      <h2>🕒 Comprobante en verificación</h2>
      <p>Recibimos tu comprobante<% if (o.receipt_ref) { %> (ref. <%= o.receipt_ref %>)<% } %>. Un administrador lo revisará pronto.</p>
      <% if (o.receipt) { %><a href="/uploads/<%= o.receipt %>" target="_blank"><% if (/\.pdf$/i.test(o.receipt)) { %>Ver PDF<% } else { %><img class="receipt-thumb" src="/uploads/<%= o.receipt %>" alt="Comprobante"><% } %></a><% } %>
    <% } else if (o.status === 'cancelled') { %>
      <h2>Pedido cancelado</h2>
    <% } else { %>
      <h2>Paga por Nequi</h2>
      <% if (!site.nequi_number) { %>
        <div class="flash warn">El administrador aún no ha configurado el número de Nequi. Escríbele para coordinar el pago.</div>
      <% } else { %>
      <div class="nequi">
        <div class="small">Envía <b><%= h.fmtCOP(o.total) %></b> al Nequi</div>
        <div class="num"><%= site.nequi_number %></div>
        <% if (site.nequi_holder) { %><div class="small">A nombre de <b><%= site.nequi_holder %></b></div><% } %>
        <button type="button" class="copy mt" data-copy="<%= site.nequi_number.replace(/\s/g,'') %>">Copiar</button>
        <% if (site.nequi_qr) { %><div><img src="/uploads/<%= site.nequi_qr %>" alt="QR Nequi"></div><% } %>
      </div>
      <% } %>
      <p class="small mt" style="white-space:pre-line"><%= site.payment_instructions %></p>
      <form method="post" action="/pedidos/<%= o.id %>/comprobante" enctype="multipart/form-data">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <label for="receipt">Captura del comprobante</label>
        <input id="receipt" type="file" name="receipt" accept="image/*,.pdf" required data-preview="rprev">
        <img id="rprev" class="receipt-thumb mt" hidden alt="">
        <label for="ref">Referencia / número de transacción (opcional)</label>
        <input id="ref" type="text" name="receipt_ref" maxlength="60" placeholder="M12345678">
        <button class="btn block mt">Enviar comprobante</button>
      </form>
    <% } %>
  </div>
</div>
<%- include('partials/foot') %>
