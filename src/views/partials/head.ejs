<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> · <%= site.site_name %></title>
<link rel="stylesheet" href="/css/style.css">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>🏡</text></svg>">
<meta name="theme-color" content="#1f5f4a">
</head>
<body>
<header class="topbar">
  <div class="wrap">
    <a class="brand" href="/"><span class="logo"><img src="/img/logo.jpeg" alt="<%= site.site_name %>"></span></a>
    <% if (user) { %>
    <nav class="nav">
      <a href="/" class="<%= path === '/' ? 'on' : '' %>">Eventos</a>
      <a href="/pedidos" class="<%= path.startsWith('/pedidos') ? 'on' : '' %>">Mis pedidos</a>
      <% if (user.role === 'admin') { %><a href="/admin" class="<%= path.startsWith('/admin') ? 'on' : '' %>">Admin</a><% } %>
      <a href="/perfil" class="<%= path === '/perfil' ? 'on' : '' %>"><%= user.name.split(' ')[0] %></a>
      <form method="post" action="/logout" class="inline"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="linkbtn">Salir</button></form>
    </nav>
    <% } %>
  </div>
</header>
<main class="wrap">
<% if (flash) { %><div class="flash <%= flash.type %>"><%= flash.msg %></div><% } %>
