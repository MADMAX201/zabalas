<%- include('partials/head') %>
<div class="auth">
  <div class="card">
    <img class="auth-logo" src="/img/logo.jpeg" alt="<%= site.site_name %>">
    <h1>Crear cuenta</h1>
    <% if (inv) { %><div class="flash ok">Invitación a <b><%= inv.event_title %></b>. Crea tu cuenta y quedarás dentro del evento.</div><input type="hidden" name="inv" value="<%= inv.token %>" form="regForm"><% } %>
    <% if (error) { %><div class="err"><%= error %></div><% } %>
    <form method="post" action="/registro" id="regForm">
      <input type="hidden" name="_csrf" value="<%= csrf %>">
      <label for="name">Nombre completo</label>
      <input id="name" type="text" name="name" value="<%= form.name || '' %>" required autocomplete="name">
      <label for="email">Correo</label>
      <input id="email" type="email" name="email" value="<%= form.email || '' %>" required autocomplete="email">
      <label for="phone">Celular (opcional)</label>
      <input id="phone" type="tel" name="phone" value="<%= form.phone || '' %>" autocomplete="tel" placeholder="300 123 4567">
      <label for="password">Contraseña</label>
      <input id="password" type="password" name="password" required minlength="6" autocomplete="new-password">
      <label for="password2">Repite la contraseña</label>
      <input id="password2" type="password" name="password2" required minlength="6" autocomplete="new-password">
      <% if (!inv) { %>
      <label for="code">Código familiar</label>
      <input id="code" type="text" name="code" value="<%= form.code || '' %>" required autocapitalize="characters" style="text-transform:uppercase">
      <div class="help">Te lo da la persona que te invitó.</div>
      <% } %>
      <button class="btn block mt">Crear mi cuenta</button>
    </form>
    <p class="center mt">¿Ya tienes cuenta? <a href="/login">Ingresar</a></p>
  </div>
</div>
<%- include('partials/foot') %>
