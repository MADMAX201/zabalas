<%- include('partials/head') %>
<div class="row between mb">
  <div>
    <h1>Hola, <%= user.name.split(' ')[0] %> 👋</h1>
    <p class="muted">Estos son los próximos encuentros de la familia.</p>
  </div>
  <div class="row">
    <% if (user.role === 'admin') { %><a class="btn" href="/admin/eventos/nuevo">+ Nuevo evento</a><% } %>
    <a class="btn <%= user.role === 'admin' ? 'sec' : '' %>" href="/eventos/organizar">🎪 Organizar un evento</a>
  </div>
</div>

<% if (pendingOrders) { %>
<div class="flash info">Tienes <%= pendingOrders %> pedido<%= pendingOrders > 1 ? 's' : '' %> pendiente<%= pendingOrders > 1 ? 's' : '' %> de pago. <a href="/pedidos">Ver mis pedidos</a></div>
<% } %>

<% const card = (e) => { const d = h.parseLocal((e.nextDate || e).starts_at); %>
  <a class="card event-card" href="/eventos/<%= e.id %>">
    <div class="img"><% if (e.image) { %><img src="/uploads/<%= e.image %>" alt=""><% } %></div>
    <div class="body">
      <div class="row between">
        <div class="date-chip"><b><%= d.getDate() %></b><span><%= h.fmtShort(e.starts_at).split(' ')[1] %></span></div>
        <% if (myRsvps[e.id]) { %><span class="badge <%= h.RSVP[myRsvps[e.id]].cls %>"><%= h.RSVP[myRsvps[e.id]].label %></span>
        <% } else if (!h.isPast(e.ends_at || e.starts_at)) { %><span class="badge warn">Sin confirmar</span><% } %>
      </div>
      <h2><%= e.title %><% if (e.access_code) { %> <span class="badge muted" title="Evento privado">🔒</span><% } %></h2>
      <% if (e.dates.length > 1) { %>
      <div class="muted small">📅 <b><%= e.dates.length %> fechas</b> · próxima: <%= h.fmtDayShort(e.nextDate.starts_at) %>, <%= h.fmtTime(e.nextDate.starts_at) %><% if (e.location) { %> · <%= e.location %><% } %></div>
      <% } else { %>
      <div class="muted small"><%= h.fmtDateTime(e.starts_at) %><% if (e.location) { %> · <%= e.location %><% } %></div>
      <% } %>
      <div class="row small muted" style="margin-top:auto">
        <span>👥 <%= e.stats.going + e.stats.guests %> asistirán</span>
        <% if (e.stats.products) { %><span>🛍️ <%= e.stats.products %> producto<%= e.stats.products > 1 ? 's' : '' %></span><% } %>
      </div>
    </div>
  </a>
<% }; %>

<% if (myEvents.length) { const ST = { pending: ['Pendiente de aprobación', 'warn'], approved: ['Aprobado', 'ok'], rejected: ['Rechazado', 'bad'] }; %>
<div class="card mb">
  <div class="row between"><h2 style="margin:0">🎪 Mis eventos</h2><a class="small" href="/mis-eventos">Ver todos</a></div>
  <table class="tbl mt">
    <% myEvents.slice(0, 4).forEach(e => { %>
    <tr><td><a href="/admin/eventos/<%= e.id %>"><b><%= e.title %></b></a> <span class="small muted"><%= h.fmtShort(e.starts_at) %></span></td>
      <td class="right"><span class="badge <%= ST[e.status][1] %>"><%= ST[e.status][0] %></span></td></tr>
    <% }) %>
  </table>
</div>
<% } %>

<h2 class="mt">Próximos eventos</h2>
<% if (!upcoming.length) { %>
  <div class="card center muted">Aún no hay eventos programados.<% if (user.role === 'admin') { %> <a href="/admin/eventos/nuevo">Crea el primero</a>.<% } %></div>
<% } else { %>
  <div class="grid"><% upcoming.forEach(card) %></div>
<% } %>

<details class="card mt2" style="padding:14px 18px">
  <summary>🔒 ¿Te invitaron a un evento privado? Ingresa el código</summary>
  <form method="post" action="/eventos/codigo" class="row mt">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <input type="text" name="code" placeholder="CÓDIGO" required autocapitalize="characters" style="text-transform:uppercase;max-width:220px">
    <button class="btn">Entrar</button>
  </form>
</details>

<% if (past.length) { %>
  <h2 class="mt2">Eventos pasados</h2>
  <div class="grid"><% past.forEach(card) %></div>
<% } %>
<%- include('partials/foot') %>
