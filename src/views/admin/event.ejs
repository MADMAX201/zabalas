<%- include('../partials/head') %>
<p><a href="<%= isOrganizer ? '/mis-eventos' : '/admin' %>">← <%= isOrganizer ? 'Mis eventos' : 'Administración' %></a></p>
<% const ST = { pending: ['Pendiente de aprobación', 'warn'], approved: ['Aprobado', 'ok'], rejected: ['Rechazado', 'bad'] }; %>
<% if (ev.status !== 'approved' || organizer) { %>
<div class="card mb" style="<%= ev.status === 'pending' ? 'border-color:var(--accent)' : '' %>">
  <div class="row between">
    <div>
      <span class="badge <%= ST[ev.status][1] %>"><%= ST[ev.status][0] %></span>
      <% if (organizer) { %> · Organiza <b><%= organizer.name %></b><% if (!isOrganizer) { %> <span class="small muted">(<%= organizer.email %><%= organizer.phone ? ' · ' + organizer.phone : '' %>)</span><% } %><% } %>
      <% if (ev.status === 'pending') { %><p class="small muted" style="margin:4px 0 0"><%= isOrganizer ? 'Un administrador revisará tu evento. Mientras tanto puedes completar fechas y productos; la familia lo verá cuando sea aprobado.' : 'Revisa los datos (y el recaudo, si vende algo) y aprueba o rechaza.' %></p><% } %>
      <% if (ev.status === 'rejected' && ev.reject_reason) { %><p class="small" style="margin:4px 0 0;color:var(--bad)">Motivo: <%= ev.reject_reason %></p><% } %>
    </div>
    <% if (!isOrganizer && ev.status !== 'approved') { %>
    <div class="row" style="gap:6px">
      <form method="post" action="/admin/eventos/<%= ev.id %>/aprobar"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn">✅ Aprobar y publicar</button></form>
      <% if (ev.status === 'pending') { %>
      <form method="post" action="/admin/eventos/<%= ev.id %>/rechazar" class="row" style="gap:4px"><input type="hidden" name="_csrf" value="<%= csrf %>">
        <input type="text" name="reason" placeholder="Motivo (lo verá el organizador)" style="width:220px;padding:6px 8px"><button class="btn bad">Rechazar</button></form>
      <% } %>
    </div>
    <% } %>
  </div>
</div>
<% } %>
<div class="row between">
  <div><h1><%= ev.title %> <% if (!ev.published) { %><span class="badge warn">Borrador</span><% } %></h1><p class="muted"><%= h.fmtDateTime(ev.starts_at) %><% if (ev.location) { %> · <%= ev.location %><% } %></p></div>
  <div class="row">
    <a class="btn sec sm" href="/eventos/<%= ev.id %>">Ver como integrante</a>
    <% if (pay.own) { %><span class="badge brand" title="<%= pay.holder %>">💸 <%= pay.method === 'breb' ? 'Bre-B' : 'Nequi' %> <%= pay.number %></span><% } else { %><span class="badge muted" title="Se usa el Nequi general del sitio">💸 Nequi del sitio</span><% } %>
    <a class="btn ghost sm" href="/admin/eventos/<%= ev.id %>/editar">Editar</a>
    <a class="btn sm sec" href="/admin/eventos/<%= ev.id %>/invitaciones">✉️ Invitaciones</a>
    <a class="btn sm" href="/admin/eventos/<%= ev.id %>/exportar.xlsx">📊 Exportar Excel</a>
  </div>
</div>
<% if (ev.access_code) { %>
<div class="card mt" style="background:var(--warn-bg);border-color:#f0d9b5">
  <div class="row between">
    <div>🔒 <b>Evento privado.</b> Código de invitación: <b style="font-size:1.3rem;letter-spacing:.12em"><%= ev.access_code %></b>
      <button type="button" class="copy" data-copy="<%= ev.access_code %>">Copiar</button></div>
    <div class="small">Enlace: <code><%= site.site_url || 'https://zabalas.online' %>/eventos/<%= ev.id %></code></div>
  </div>
  <p class="small muted" style="margin:6px 0 0">Admitidos con código (<%= admitted.length %>): <%= admitted.map(x => x.name).join(', ') || 'nadie todavía' %></p>
</div>
<% } %>
<% if (totals.self && totals.self.length) { %>
<div class="flash info mt">Con cuenta propia y ya confirmaron por su cuenta (no se cuentan como acompañantes): <%= totals.self.map(d => `${d.name} (núcleo de ${d.owner})`).join('; ') %></div>
<% } %>
<% if (totals.dups && totals.dups.length) { %>
<div class="flash info mt">Personas marcadas por más de un titular (se cuentan una sola vez): <%= totals.dups.map(d => `${d.name} (${d.owners.join(' y ')})`).join('; ') %></div>
<% } %>
<div class="stats mt mb">
  <div class="stat"><b><%= totals.yes %><% if (totals.guests) { %> <span style="font-size:1rem">+<%= totals.guests %></span><% } %></b><span>confirmados (+ acompañantes)</span></div>
  <div class="stat"><b><%= totals.maybe %></b><span>tal vez</span></div>
  <div class="stat"><b><%= totals.no %></b><span>no asisten</span></div>
  <div class="stat"><b><%= h.fmtCOP(totals.paid) %></b><span>recaudado</span></div>
  <div class="stat"><b><%= h.fmtCOP(totals.outstanding) %></b><span>por cobrar</span></div>
</div>

<div class="card mb" id="fechas">
  <h2>Fechas del evento <span class="badge brand"><%= dates.length %></span></h2>
  <p class="muted small">Un evento puede tener varias fechas (ensayos, partidos, jornadas). Los integrantes marcan a cuáles asisten.</p>
  <div class="scroll"><table class="tbl">
    <tr><th>Etiqueta</th><th>Inicio</th><th>Fin</th><th>Lugar</th><th>Dirección</th><th>Asisten</th><th></th></tr>
    <% dates.forEach(d => { %>
    <tr>
      <form method="post" action="/admin/fechas/<%= d.id %>/editar" id="df<%= d.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
      <td><input form="df<%= d.id %>" type="text" name="label" value="<%= d.label || '' %>" placeholder="Ensayo 1" style="min-width:110px"></td>
      <td><input form="df<%= d.id %>" type="datetime-local" name="starts_at" value="<%= d.starts_at %>" required></td>
      <td><input form="df<%= d.id %>" type="datetime-local" name="ends_at" value="<%= d.ends_at || '' %>"></td>
      <td><input form="df<%= d.id %>" type="text" name="location" value="<%= d.location || '' %>" placeholder="<%= ev.location || '' %>" style="min-width:120px"></td>
      <td><input form="df<%= d.id %>" type="text" name="address" value="<%= d.address || '' %>" style="min-width:120px"></td>
      <td><b><%= d.going %></b></td>
      <td><div class="row" style="gap:4px;flex-wrap:nowrap">
        <button form="df<%= d.id %>" class="btn sm">Guardar</button>
        <form method="post" action="/admin/fechas/<%= d.id %>/eliminar" data-confirm="¿Eliminar esta fecha? Se borran las asistencias marcadas en ella."><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm" <%= dates.length <= 1 ? 'disabled' : '' %>>🗑</button></form>
      </div></td>
    </tr>
    <% }) %>
    <tr style="background:var(--brand-soft)">
      <form method="post" action="/admin/eventos/<%= ev.id %>/fechas" id="dfnew"><input type="hidden" name="_csrf" value="<%= csrf %>"></form>
      <td><input form="dfnew" type="text" name="label" placeholder="Etiqueta (opcional)" style="min-width:110px"></td>
      <td><input form="dfnew" type="datetime-local" name="starts_at" required></td>
      <td><input form="dfnew" type="datetime-local" name="ends_at"></td>
      <td><input form="dfnew" type="text" name="location" placeholder="<%= ev.location || 'Lugar' %>" style="min-width:120px"></td>
      <td><input form="dfnew" type="text" name="address" placeholder="Dirección" style="min-width:120px"></td>
      <td></td>
      <td><button form="dfnew" class="btn sm">+ Agregar fecha</button></td>
    </tr>
  </table></div>
</div>

<div class="card mb" id="productos">
  <div class="row between"><h2>Productos</h2><a class="btn sm" href="/admin/eventos/<%= ev.id %>/productos/nuevo">+ Producto</a></div>
  <% if (!products.length) { %><p class="muted">Sin productos. Agrega camisetas, boletas, rifas…</p><% } else { %>
  <div class="scroll"><table class="tbl">
    <tr><th>Producto</th><th>Precio</th><th>Tallas</th><th>Pedidas</th><th>Pagadas</th><th>Stock</th><th></th></tr>
    <% products.forEach(p => { %>
    <tr>
      <td><b><%= p.name %></b> <% if (!p.active) { %><span class="badge muted">Inactivo</span><% } %></td>
      <td><%= h.fmtCOP(p.price) %></td><td class="small"><%= p.sizes || '—' %></td>
      <td><%= p.sold %></td><td><%= p.paidQty %></td><td><%= p.stock === null ? '∞' : p.stock %></td>
      <td class="right"><div class="row" style="justify-content:flex-end;gap:4px"><a class="btn ghost sm" href="/admin/productos/<%= p.id %>/editar">Editar</a>
        <form method="post" action="/admin/productos/<%= p.id %>/eliminar" data-confirm="¿Eliminar este producto?"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn ghost sm">🗑</button></form></div></td>
    </tr>
    <% }) %>
  </table></div>
  <% if (sizeSummary.length) { %>
  <details class="mt"><summary>Resumen por talla</summary>
    <table class="tbl small mt"><tr><th>Producto</th><th>Talla</th><th>Estado</th><th>Cantidad</th></tr>
    <% sizeSummary.forEach(s => { %><tr><td><%= s.name %></td><td><%= s.size || '—' %></td><td><span class="badge <%= h.ORDER_STATUS[s.status].cls %>"><%= h.ORDER_STATUS[s.status].label %></span></td><td><%= s.qty %></td></tr><% }) %>
    </table></details>
  <% } %>
  <% } %>
</div>

<div class="card mb" id="pedidos">
  <h2>Pedidos y pagos</h2>
  <% if (!orders.length) { %><p class="muted">Aún no hay pedidos.</p><% } else { %>
  <div class="scroll"><table class="tbl">
    <tr><th>#</th><th>Integrante</th><th>Productos</th><th>Total</th><th>Estado</th><th style="min-width:340px">Abonos y acciones</th></tr>
    <% orders.forEach(o => { %>
    <tr>
      <td><a href="/pedidos/<%= o.id %>">#<%= o.id %></a></td>
      <td><%= o.user_name %><% if (o.phone) { %><br><span class="small muted"><%= o.phone %></span><% } %></td>
      <td class="small"><%= o.items.map(i => `${i.qty}× ${i.name}${i.size ? ' ('+i.size+')' : ''}${i.for_name ? ' para '+i.for_name : ''}`).join('; ') %></td>
      <td><b><%= h.fmtCOP(o.total) %></b><% if (o.paid > 0 && o.paid < o.total) { %><br><span class="small muted">abonado <%= h.fmtCOP(o.paid) %></span><% } %></td>
      <td><span class="badge <%= h.ORDER_STATUS[o.status].cls %>"><%= h.ORDER_STATUS[o.status].label %></span></td>
      <td><%- include('_order_actions', { o, back: '/admin/eventos/' + ev.id + '#pedidos' }) %></td>
    </tr>
    <% }) %>
  </table></div>
  <% } %>
</div>

<div class="card mb" id="asistencia">
  <h2>Asistencia</h2>
  <% if (!attendees.length) { %><p class="muted">Nadie ha respondido todavía.</p><% } else { %>
  <div class="scroll"><table class="tbl">
    <tr><th>Nombre</th><th>Contacto</th><th>Respuesta</th><th>Acomp.</th>
      <% if (dates.length > 1) dates.forEach(d => { %><th class="center" title="<%= h.fmtDateTime(d.starts_at) %>"><%= d.label || h.fmtDayShort(d.starts_at) %></th><% }) %>
      <th>Nota</th></tr>
    <% attendees.forEach(a => { %>
    <tr><td><%= a.name %></td><td class="small"><%= a.email %><% if (a.phone) { %><br><%= a.phone %><% } %></td>
      <td><span class="badge <%= h.RSVP[a.status].cls %>"><%= h.RSVP[a.status].label %></span></td>
      <td><%= a.status === 'yes' ? a.guests : '' %><% if (a.companions.length) { %><br><span class="small muted"><%= a.companions.join(', ') %></span><% } %></td>
      <% if (dates.length > 1) dates.forEach(d => { %><td class="center"><%= dateRsvps[a.user_id] && dateRsvps[a.user_id].has(d.id) ? '✅' : '' %></td><% }) %>
      <td class="small"><%= a.note || '' %></td></tr>
    <% }) %>
    <% if (dates.length > 1) { %><tr><td colspan="4"><b>Total por fecha</b></td><% dates.forEach(d => { %><td class="center"><b><%= d.going %></b></td><% }) %><td></td></tr><% } %>
  </table></div>
  <% } %>
</div>

<% if (!isOrganizer || ev.status !== 'approved') { %>
<form method="post" action="/admin/eventos/<%= ev.id %>/eliminar" data-confirm="Se eliminará el evento con sus productos, pedidos y asistencias. ¿Seguro?" class="right">
  <input type="hidden" name="_csrf" value="<%= csrf %>"><button class="btn bad sm">Eliminar evento</button>
</form>
<% } %>
<%- include('../partials/foot') %>
