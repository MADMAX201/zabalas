<%- include('../partials/head') %>
<h1>Integrantes</h1>
<%- include('_nav') %>
<p class="muted">Código familiar para registrarse: <b><%= site.family_code %></b> (se cambia en Ajustes).</p>
<div class="card pad0 scroll"><table class="tbl">
  <tr><th>Nombre</th><th>Contacto</th><th>Rol</th><th>Estado</th><th>Actividad</th><th>Acciones</th></tr>
  <% users.forEach(u => { %>
  <tr>
    <td><b><%= u.name %></b><br><span class="small muted">desde <%= u.created_at.slice(0,10) %></span></td>
    <td class="small"><%= u.email %><% if (u.phone) { %><br><%= u.phone %><% } %></td>
    <td><span class="badge <%= u.role === 'admin' ? 'brand' : 'muted' %>"><%= u.role === 'admin' ? 'Admin' : 'Integrante' %></span></td>
    <td><span class="badge <%= u.active ? 'ok' : 'bad' %>"><%= u.active ? 'Activo' : 'Desactivado' %></span></td>
    <td class="small"><%= u.rsvps %> asistencias · <%= u.paid_orders %> pagos</td>
    <td>
      <form method="post" action="/admin/usuarios/<%= u.id %>" class="row" style="gap:4px">
        <input type="hidden" name="_csrf" value="<%= csrf %>">
        <% if (u.id !== user.id) { %>
          <% if (u.active) { %><button class="btn ghost sm" name="action" value="deactivate">Desactivar</button><% } else { %><button class="btn sm" name="action" value="activate">Activar</button><% } %>
          <% if (u.role === 'admin') { %><button class="btn ghost sm" name="action" value="demote">Quitar admin</button><% } else { %><button class="btn ghost sm" name="action" value="promote">Hacer admin</button><% } %>
        <% } %>
        <button class="btn ghost sm" name="action" value="reset" onclick="return confirm('¿Generar una contraseña temporal para <%= u.name %>?')">Restablecer clave</button>
      </form>
    </td>
  </tr>
  <% }) %>
</table></div>
<%- include('../partials/foot') %>
