<%- include('partials/head') %>
<% const back = de === 'mia' ? '/galeria/mia' : '/galeria'; const q = de ? '?de=' + de : ''; %>
<div class="row between mb">
  <a href="<%= back %>">← <%= de === 'mia' ? 'Mi galería' : 'Galería' %></a>
  <div class="row" style="gap:6px">
    <% if (prev) { %><a class="btn ghost sm" href="/galeria/<%= prev.id %><%= q %>">‹ Anterior</a><% } %>
    <% if (next) { %><a class="btn ghost sm" href="/galeria/<%= next.id %><%= q %>">Siguiente ›</a><% } %>
  </div>
</div>
<div class="card pad0 center" style="background:#111">
  <% if (m.kind === 'image') { %>
    <img src="/uploads/galeria/<%= m.file %>" alt="<%= m.caption || '' %>" style="max-height:78vh;width:auto;max-width:100%;display:block;margin:0 auto">
  <% } else { %>
    <video src="/uploads/galeria/<%= m.file %>" controls playsinline style="max-height:78vh;width:100%;display:block"></video>
  <% } %>
</div>
<div class="card mt">
  <div class="row between">
    <div>
      <% if (m.caption) { %><h2><%= m.caption %></h2><% } %>
      <p class="muted small">Subido por <b><%= m.user_name %></b> · <%= h.fmtDateTime(m.created_at.replace(' ', 'T').slice(0,16)) %>
        <% if (m.event_title) { %> · <a href="/galeria?evento=<%= m.event_id %>">📅 <%= m.event_title %></a><% } %>
        · <span class="badge <%= m.visibility === 'family' ? 'ok' : 'muted' %>"><%= m.visibility === 'family' ? 'Familia' : '🔒 Solo yo' %></span></p>
    </div>
    <a class="btn ghost sm" href="/uploads/galeria/<%= m.file %>" download>⬇ Descargar</a>
  </div>
  <% if (isOwner) { %>
  <details class="mt"><summary style="cursor:pointer;font-weight:600">Editar</summary>
    <form method="post" action="/galeria/<%= m.id %>/editar">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="de" value="<%= de %>">
      <label>Descripción</label><input type="text" name="caption" value="<%= m.caption || '' %>" maxlength="300">
      <label>Evento</label>
      <select name="event_id"><option value="">Sin evento</option>
        <% (typeof events !== 'undefined' ? events : []).forEach(e => { %><option value="<%= e.id %>" <%= m.event_id === e.id ? 'selected' : '' %>><%= e.title %></option><% }) %>
        <% if (m.event_id && !(typeof events !== 'undefined' && events.some(e => e.id === m.event_id))) { %><option value="<%= m.event_id %>" selected><%= m.event_title %></option><% } %>
      </select>
      <label>¿Quién puede verlo?</label>
      <div class="seg">
        <label><input type="radio" name="visibility" value="family" <%= m.visibility === 'family' ? 'checked' : '' %>><span>👨‍👩‍👧 Toda la familia</span></label>
        <label><input type="radio" name="visibility" value="private" <%= m.visibility === 'private' ? 'checked' : '' %>><span>🔒 Solo yo</span></label>
      </div>
      <div class="row mt">
        <button class="btn">Guardar</button>
      </div>
    </form>
    <form method="post" action="/galeria/<%= m.id %>/eliminar" data-confirm="¿Eliminar este archivo definitivamente?" class="mt">
      <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="de" value="<%= de %>">
      <button class="btn ghost sm" style="color:var(--bad)">🗑 Eliminar</button>
    </form>
  </details>
  <% } %>
</div>
<%- include('partials/foot') %>
